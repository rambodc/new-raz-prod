rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: firstName, lastName, email, photoURL, role, createdAt, updatedAt.
    // Optional invitedBy and inviteCode are written by Cloud Functions when a new account
    // arrives through an invite. Clients can never set or change them.
    // role is "fan" or "artist". Clients create fans only and can never change role or email.
    // artists/{uid}: name, bio, imageURL, ownerUid, slug, createdAt, updatedAt, optional ogRevision.
    //   Public read. Created by setUserRole (Admin SDK), which also claims slugs/{slug}.
    //   The owner may update name, bio and imageURL only. slug and ogRevision stay put.
    // slugs/{slug}: { artistId, kind: "artist" }. Public get so a share URL can resolve. Clients cannot write.
    // events/{eventId}: artistId, title, startsAt, venue, city, description, imageURL, ticketUrl,
    //   visibility ("public" | "private"), showGuestList, slug, createdAt, updatedAt, optional ogRevision.
    //   Public events are world-readable. A private event is readable by the owning artist,
    //   someone with events/{eventId}/access/{uid} (written only by a function after a valid invite),
    //   or someone whose events/{eventId}/rsvps/{uid} says status "going".
    //   Clients cannot write rsvps, access, stats, or invites. Invites live in invites/{code}
    //   and are server-only, so a code cannot be listed or forged.
    // artists/{artistId}/eventShares/{slug}: { eventId }. The per-artist lock for an event share URL.
    // artists/{artistId}/trackShares/{slug}: { trackId }. The per-artist lock for a track share URL.
    // artists/{artistId}/tracks/{trackId}: title, duration, order, audioURL, coverURL, slug, createdAt, updatedAt.
    //   Public read. Only that artist can write. Audio lives in Storage at artists/{artistId}/tracks/.
    // loginCodes, emailChanges and authRateLimits are written only by Cloud Functions (the Admin SDK).
    // A photo URL is empty or a download URL for this user's own avatar.

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 60
        && name.matches('.*\\S.*');
    }

    function validPhoto(url) {
      return url is string && (
        url == ''
        || (
          url.size() <= 2048
          && (
            url.matches('https://firebasestorage\\.googleapis\\.com/.*')
            || url.matches('https://storage\\.googleapis\\.com/.*')
            || url.matches('http://127\\.0\\.0\\.1:9199/.*')
            || url.matches('http://localhost:9199/.*')
          )
          && (
            url.matches('.*users%2F' + request.auth.uid + '%2Favatar.*')
            || url.matches('.*users/' + request.auth.uid + '/avatar.*')
          )
        )
      );
    }

    function optionalAttribution(d) {
      return (!('invitedBy' in d) || (
          d.invitedBy is string && d.invitedBy.size() <= 128 && d.invitedBy.matches('^[A-Za-z0-9]*$')
        ))
        && (!('inviteCode' in d) || (
          d.inviteCode is string && d.inviteCode.size() <= 16 && d.inviteCode.matches('^[a-z0-9]*$')
        ))
        && (!('signupCounted' in d) || d.signupCounted is bool);
    }

    function attributionHeld(before, after) {
      return (
          (!('invitedBy' in before) && !('invitedBy' in after))
          || (('invitedBy' in before) && after.invitedBy == before.invitedBy)
        )
        && (
          (!('inviteCode' in before) && !('inviteCode' in after))
          || (('inviteCode' in before) && after.inviteCode == before.inviteCode)
        )
        && (
          (!('signupCounted' in before) && !('signupCounted' in after))
          || (('signupCounted' in before) && after.signupCounted == before.signupCounted)
        );
    }

    function validUser(d) {
      return d.keys().hasOnly(['firstName', 'lastName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt', 'invitedBy', 'inviteCode', 'signupCounted'])
        && d.keys().hasAll(['firstName', 'lastName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && optionalAttribution(d)
        && validName(d.firstName)
        && validName(d.lastName)
        && d.email is string
        && d.email.size() > 0
        && d.email.size() <= 254
        && d.email == request.auth.token.email
        && validPhoto(d.photoURL)
        && (d.role == 'fan' || d.role == 'artist')
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // Each signed-in user may read and write only their own profile. No deletes, no lists.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && validUser(request.resource.data)
        && request.resource.data.role == 'fan'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('invitedBy' in request.resource.data) || request.resource.data.invitedBy == '')
        && (!('inviteCode' in request.resource.data) || request.resource.data.inviteCode == '')
        && (!('signupCounted' in request.resource.data) || request.resource.data.signupCounted == false);
      allow update: if isOwner(userId)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.updatedAt == request.time
        && attributionHeld(resource.data, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'photoURL', 'updatedAt']);
      allow list, delete: if false;
    }

    match /loginCodes/{id} {
      allow read, write: if false;
    }

    match /emailChanges/{id} {
      allow read, write: if false;
    }

    match /authRateLimits/{id} {
      allow read, write: if false;
    }

    // Admins are listed in admins/{uid}. A signed-in user can read only their own entry (so the app knows
    // whether to show the admin page). Nobody can write here from a client: it is seeded with the Admin SDK.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // The fan's own numbers, one document per artist. Only the checkIn function writes them.
    match /users/{userId}/artistCounts/{artistId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    function safeId(id) {
      return id.matches('^[A-Za-z0-9]{1,128}$');
    }

    function hostedImage(url) {
      return url is string
        && url.size() > 0
        && url.size() <= 2048
        && (
          url.matches('https://firebasestorage\\.googleapis\\.com/[^?]+(\\?.*)?')
          || url.matches('https://storage\\.googleapis\\.com/[^?]+(\\?.*)?')
          || url.matches('http://127\\.0\\.0\\.1:9199/[^?]+(\\?.*)?')
          || url.matches('http://localhost:9199/[^?]+(\\?.*)?')
        );
    }

    // The folder must appear in the URL path, not only in the query string.
    function urlInFolder(url, folder, id) {
      return hostedImage(url) && (
        url.matches('https://[^?]*' + folder + '%2F' + id + '%2F[^?]*(\\?.*)?')
        || url.matches('http://[^?]*' + folder + '%2F' + id + '%2F[^?]*(\\?.*)?')
        || url.matches('https://[^?]*/' + folder + '/' + id + '/[^?]*(\\?.*)?')
        || url.matches('http://[^?]*/' + folder + '/' + id + '/[^?]*(\\?.*)?')
      );
    }

    function avatarUrl(url, id) {
      return hostedImage(url) && (
        url.matches('https://[^?]*users%2F' + id + '%2Favatar[^?]*(\\?.*)?')
        || url.matches('http://[^?]*users%2F' + id + '%2Favatar[^?]*(\\?.*)?')
        || url.matches('https://[^?]*/users/' + id + '/avatar[^?]*(\\?.*)?')
        || url.matches('http://[^?]*/users/' + id + '/avatar[^?]*(\\?.*)?')
      );
    }

    function textOk(value, max) {
      return value is string && value.size() > 0 && value.size() <= max && value.matches('.*\\S.*');
    }

    function validSlugValue(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 60
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function callerIsArtist() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artist';
    }

    // Artist pages are public. The server creates them. The owner, while their user doc says artist,
    // may change the name, bio and image. Fans of the old counter live in a subcollection clients never touch.
    match /artists/{artistId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if callerIsArtist()
        && safeId(artistId)
        && request.auth.uid == artistId
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'bio', 'imageURL', 'ownerUid', 'createdAt', 'updatedAt', 'slug', 'ogRevision'])
        && request.resource.data.keys().hasAll(['name', 'bio', 'imageURL', 'ownerUid', 'createdAt', 'updatedAt', 'slug'])
        && validSlugValue(request.resource.data.slug)
        && request.resource.data.slug == resource.data.slug
        && (!('ogRevision' in request.resource.data) || request.resource.data.ogRevision == resource.data.ogRevision)
        && textOk(request.resource.data.name, 80)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 600
        && (
          request.resource.data.imageURL == resource.data.imageURL
          || request.resource.data.imageURL == ''
          || urlInFolder(request.resource.data.imageURL, 'artists', artistId)
          || avatarUrl(request.resource.data.imageURL, artistId)
        )
        && request.resource.data.imageURL is string
        && request.resource.data.imageURL.size() <= 2048
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'imageURL', 'updatedAt']);
    }

    function validTicket(url) {
      return url is string && (
        url.size() == 0
        || (
          url.size() >= 8
          && url.size() <= 2048
          && (url.matches('^https://\\S+$') || url.matches('^http://\\S+$'))
        )
      );
    }

    function optionalRevision(d) {
      return !('ogRevision' in d) || (
        d.ogRevision is string
        && d.ogRevision.size() > 0
        && d.ogRevision.size() <= 64
        && d.ogRevision.matches('^[a-f0-9]+$')
      );
    }

    function eventIsPublic() {
      return resource.data.visibility == 'public';
    }

    function eventOwner() {
      return request.auth != null && resource.data.artistId == request.auth.uid;
    }

    function validEvent(eventId) {
      let d = request.resource.data;
      return safeId(eventId)
        && d.keys().hasOnly(['artistId', 'title', 'startsAt', 'venue', 'city', 'description', 'imageURL', 'ticketUrl', 'createdAt', 'updatedAt', 'slug', 'visibility', 'showGuestList', 'ogRevision'])
        && d.keys().hasAll(['artistId', 'title', 'startsAt', 'venue', 'city', 'description', 'imageURL', 'ticketUrl', 'createdAt', 'updatedAt', 'slug', 'visibility', 'showGuestList'])
        && d.artistId == request.auth.uid
        && textOk(d.title, 120)
        && d.startsAt is timestamp
        && textOk(d.venue, 120)
        && textOk(d.city, 80)
        && textOk(d.description, 2000)
        && urlInFolder(d.imageURL, 'events', eventId)
        && validTicket(d.ticketUrl)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && validSlugValue(d.slug)
        && d.slug != 't'
        && (request.method == 'create' || d.slug == resource.data.slug)
        && (d.visibility == 'public' || d.visibility == 'private')
        && d.showGuestList is bool
        && optionalRevision(d)
        && (request.method != 'create' || !('ogRevision' in d));
    }

    // Public events are readable by anyone. Private events are readable by the owning artist.
    // A list has to name visibility or the owner, so a fan cannot pull someone else's private nights.
    match /events/{eventId} {
      allow get: if eventIsPublic() || eventOwner();
      allow get: if goingHere(eventId) || accessHere(eventId);
      allow list: if resource.data.visibility == 'public' || eventOwner();
      allow create: if callerIsArtist()
        && validEvent(eventId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if callerIsArtist()
        && resource.data.artistId == request.auth.uid
        && validEvent(eventId)
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.slug == resource.data.slug
        && (!('ogRevision' in resource.data) || request.resource.data.ogRevision == resource.data.ogRevision)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'startsAt', 'venue', 'city', 'description', 'imageURL', 'ticketUrl', 'visibility', 'showGuestList', 'updatedAt']);
      allow delete: if callerIsArtist() && resource.data.artistId == request.auth.uid;

      // A function writes this after a valid invite. The person can see their own grant. Nobody can list or forge one.
      match /access/{uid} {
        allow get: if isOwner(uid);
        allow list, write: if false;
      }

      // RSVPs are written only by rsvpGoing / rsvpCancel. Guests do not get a list, so invite attribution stays with the host.
      match /rsvps/{uid} {
        allow get: if isOwner(uid) || (request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.artistId == request.auth.uid);
        allow list: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.artistId == request.auth.uid;
        allow write: if false;
      }

      // public is a count. host is opens, RSVPs, and new signups. Clients cannot write either.
      match /stats/{statId} {
        allow get: if (statId == 'public' && (
            get(/databases/$(database)/documents/events/$(eventId)).data.visibility == 'public'
            || (request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.artistId == request.auth.uid)
            || (request.auth != null && exists(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid)))
            || (request.auth != null && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid))
              && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid)).data.status == 'going')
          ))
          || (statId == 'host' && request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.artistId == request.auth.uid);
        allow list, write: if false;
      }

      // Old placeholder path. Invites live in the top-level invites collection and stay server-only.
      match /invites/{inviteId} {
        allow read, write: if false;
      }
    }

    // Invite codes and open dedupe records. Only Cloud Functions (Admin SDK) touch these.
    match /invites/{code} {
      allow read, write: if false;
    }

    match /inviteOpens/{openId} {
      allow read, write: if false;
    }

    function goingHere(eventId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid))
        && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid)).data.status == 'going';
    }

    function accessHere(eventId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid));
    }

    function urlInTracks(url, artistId) {
      return urlInFolder(url, 'artists', artistId) && (
        url.matches('.*artists%2F' + artistId + '%2Ftracks%2F.*')
        || url.matches('.*/artists/' + artistId + '/tracks/.*')
      );
    }

    function imageCover(url, artistId) {
      return urlInFolder(url, 'artists', artistId)
        && url.matches('.*\\.(jpg|jpeg|png|webp)(\\?.*)?$');
    }

    function ownsArtistPage(artistId) {
      return callerIsArtist()
        && request.auth.uid == artistId
        && exists(/databases/$(database)/documents/artists/$(artistId))
        && get(/databases/$(database)/documents/artists/$(artistId)).data.ownerUid == request.auth.uid;
    }

    function validTrack(artistId, trackId) {
      let d = request.resource.data;
      return safeId(trackId)
        && safeId(artistId)
        && d.keys().hasOnly(['title', 'duration', 'order', 'audioURL', 'coverURL', 'createdAt', 'updatedAt', 'slug', 'ogRevision'])
        && d.keys().hasAll(['title', 'duration', 'order', 'audioURL', 'coverURL', 'createdAt', 'updatedAt', 'slug'])
        && validSlugValue(d.slug)
        && (request.method == 'create' || d.slug == resource.data.slug)
        && optionalRevision(d)
        && (request.method != 'create' || !('ogRevision' in d))
        && textOk(d.title, 120)
        && d.duration is number
        && d.duration > 0
        && d.duration <= 14400
        && d.order is int
        && d.order >= 0
        && d.order <= 1000
        && urlInTracks(d.audioURL, artistId)
        && (d.coverURL == '' || imageCover(d.coverURL, artistId))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // Tracks are public. A fan cannot write one, and an artist cannot write someone else's.
    match /artists/{artistId}/tracks/{trackId} {
      allow read: if true;
      allow create: if ownsArtistPage(artistId)
        && validTrack(artistId, trackId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsArtistPage(artistId)
        && validTrack(artistId, trackId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.slug == resource.data.slug
        && (!('ogRevision' in resource.data) || request.resource.data.ogRevision == resource.data.ogRevision)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'duration', 'order', 'audioURL', 'coverURL', 'updatedAt']);
      allow delete: if ownsArtistPage(artistId);
    }

    // Shows are readable by signed-in users. Admins add them, change the end time, or delete them.
    function validShow(d) {
      return d.keys().hasOnly(['venue', 'lat', 'lng', 'startsAt', 'endsAt', 'artistIds', 'artistNames', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['venue', 'lat', 'lng', 'startsAt', 'endsAt', 'artistIds', 'artistNames', 'createdAt', 'createdBy'])
        && d.venue is string && d.venue.size() > 0 && d.venue.size() <= 120
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt
        && d.artistIds is list && d.artistIds.size() >= 1 && d.artistIds.size() <= 20
        && d.artistNames is list && d.artistNames.size() == d.artistIds.size()
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }

    match /shows/{showId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && validShow(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endsAt'])
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > resource.data.startsAt;
      allow delete: if isAdmin();
    }

    // Check-ins are written only by the checkIn function. A fan can read their own, by id ("showId_uid") or by query.
    match /checkins/{checkinId} {
      allow get: if request.auth != null && checkinId.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$');
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Artist handles. The document is only an id pointer. Clients cannot claim or steal one.
    match /slugs/{slug} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    function linkedEventPublic(artistId) {
      let eventId = resource.data.eventId;
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return eventId is string
        && safeId(eventId)
        && exists(eventPath)
        && get(eventPath).data.artistId == artistId
        && get(eventPath).data.visibility == 'public';
    }

    // One event slug per artist. Create only when the event already says this slug and this owner.
    match /artists/{artistId}/eventShares/{slug} {
      allow get: if (request.auth != null && request.auth.uid == artistId) || linkedEventPublic(artistId);
      allow list: if false;
      allow create: if ownsArtistPage(artistId)
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && slug != 't'
        && request.resource.data.keys().hasOnly(['eventId'])
        && request.resource.data.keys().hasAll(['eventId'])
        && safeId(request.resource.data.eventId)
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.artistId == artistId
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.slug == slug;
      allow update: if false;
      allow delete: if ownsArtistPage(artistId);
    }

    match /artists/{artistId}/trackShares/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if ownsArtistPage(artistId)
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.keys().hasOnly(['trackId'])
        && request.resource.data.keys().hasAll(['trackId'])
        && safeId(request.resource.data.trackId)
        && exists(/databases/$(database)/documents/artists/$(artistId)/tracks/$(request.resource.data.trackId))
        && get(/databases/$(database)/documents/artists/$(artistId)/tracks/$(request.resource.data.trackId)).data.slug == slug;
      allow update: if false;
      allow delete: if ownsArtistPage(artistId);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
