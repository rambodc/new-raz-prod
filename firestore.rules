rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Exactly { displayName, email, createdAt } with the right types and sizes.
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && d.keys().hasAll(['displayName', 'email', 'createdAt'])
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 80
        && d.email is string
        && d.email.size() <= 254
        && d.email == request.auth.token.email
        && d.createdAt is timestamp;
    }

    // Each signed-in user may read, create and update only their own profile. No deletes, no lists.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow list, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
