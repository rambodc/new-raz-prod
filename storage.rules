rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Artist images are public to read, so a plain <img> works. Nobody can write from a client: the
    // setArtistImage function (admins only) saves them, checks the type and caps the size at 5 MB.
    match /artists/{artistId}/{file} {
      allow read: if true;
      allow write: if false;
    }

    // The signed-in user can read and replace only their own avatar. Images only, under 2 MB.
    match /users/{userId}/avatar {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{object=**} {
      allow read, write: if false;
    }
  }
}
