# Firebase web app config (public client configuration, not a secret).
# Copy to .env.local for local development. Get the API key with:
#   firebase apps:sdkconfig WEB 1:555086285693:web:9b4efe2d2aa152f4849a14 --project new-raz-prod
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=new-raz-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=new-raz-prod
VITE_FIREBASE_STORAGE_BUCKET=new-raz-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=555086285693
VITE_FIREBASE_APP_ID=1:555086285693:web:9b4efe2d2aa152f4849a14
